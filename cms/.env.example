# =========================================================================
# COMFORT JOURNEY - DIRECTUS HEADLESS CMS ENVIRONMENT CONFIGURATION
# Copy to .env when running locally or deploying to AWS
# =========================================================================

# Unique Security Keys (Generate random UUIDs in production)
KEY=comfort-journey-secret-key-30-years-excellence
SECRET=comfort-journey-secret-token-bhopal-vip

# Admin Credentials (For first login)
ADMIN_EMAIL=admin@comfortjourney.com
ADMIN_PASSWORD=comfort_admin_pass_1992!

# Server & CORS Settings
PORT=8055
PUBLIC_URL=http://localhost:8055
CORS_ENABLED=true
CORS_ORIGIN=true

# Database (PostgreSQL)
DB_CLIENT=pg
DB_HOST=database
DB_PORT=5432
DB_DATABASE=directus_comfort_journey
DB_USER=directus
DB_PASSWORD=comfort_journey_db_password_1992

# Redis Cache
CACHE_ENABLED=true
CACHE_STORE=redis
REDIS=redis://cache:6379

# Storage Configuration (Default: Local Docker Volume)
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# =========================================================================
# AWS S3 MEDIA STORAGE (Uncomment for AWS Production Deployment)
# =========================================================================
# STORAGE_LOCATIONS=s3
# STORAGE_S3_DRIVER=s3
# STORAGE_S3_KEY=YOUR_AWS_IAM_ACCESS_KEY
# STORAGE_S3_SECRET=YOUR_AWS_IAM_SECRET_KEY
# STORAGE_S3_BUCKET=comfort-journey-media-storage
# STORAGE_S3_REGION=ap-south-1
