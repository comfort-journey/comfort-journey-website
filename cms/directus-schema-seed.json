{
  "version": 1,
  "directus": "10.13.1",
  "collections": [
    {
      "collection": "tour_packages",
      "meta": {
        "icon": "luggage",
        "note": "Comfort Journey Handcrafted VIP Tour Packages",
        "display_template": "{{title}} - ₹{{price}} ({{duration}})",
        "sort_field": "sort"
      },
      "schema": {
        "name": "tour_packages"
      }
    },
    {
      "collection": "blogs",
      "meta": {
        "icon": "article",
        "note": "Editorial Travel Guides, Stays Reviews & Magazines",
        "display_template": "{{title}} [{{category}}]",
        "sort_field": "published_date"
      },
      "schema": {
        "name": "blogs"
      }
    },
    {
      "collection": "blogs_tour_packages",
      "meta": {
        "icon": "import_export",
        "hidden": true,
        "note": "M2M Junction collection linking Blogs to Suggested Tour Packages"
      },
      "schema": {
        "name": "blogs_tour_packages"
      }
    },
    {
      "collection": "destinations",
      "meta": {
        "icon": "public",
        "note": "Continents, Countries and Travel Circuits",
        "display_template": "{{name}} ({{country}}, {{continent}})"
      },
      "schema": {
        "name": "destinations"
      }
    },
    {
      "collection": "global_settings",
      "meta": {
        "icon": "settings",
        "singleton": true,
        "note": "Agency Phone, WhatsApp Desk, Address & Global Announcements"
      },
      "schema": {
        "name": "global_settings"
      }
    }
  ],
  "fields": [
    {
      "collection": "tour_packages",
      "field": "id",
      "type": "string",
      "meta": { "interface": "input", "hidden": true },
      "schema": { "is_primary_key": true }
    },
    {
      "collection": "tour_packages",
      "field": "status",
      "type": "string",
      "meta": { "interface": "select-dropdown", "options": { "choices": [{ "text": "Published", "value": "published" }, { "text": "Draft", "value": "draft" }] } }
    },
    {
      "collection": "tour_packages",
      "field": "title",
      "type": "string",
      "meta": { "interface": "input", "required": true }
    },
    {
      "collection": "tour_packages",
      "field": "slug",
      "type": "string",
      "meta": { 
        "interface": "slug", 
        "required": true, 
        "options": { "field": "title", "slugify": true, "allowManual": true },
        "note": "Auto-generates from Title with manual override support for SEO" 
      }
    },
    {
      "collection": "tour_packages",
      "field": "price",
      "type": "integer",
      "meta": { "interface": "input", "required": true }
    },
    {
      "collection": "tour_packages",
      "field": "orig_price",
      "type": "integer",
      "meta": { "interface": "input" }
    },
    {
      "collection": "tour_packages",
      "field": "duration",
      "type": "string",
      "meta": { "interface": "input", "placeholder": "5 Nights / 6 Days" }
    },
    {
      "collection": "tour_packages",
      "field": "category",
      "type": "string",
      "meta": { "interface": "select-dropdown" }
    },
    {
      "collection": "tour_packages",
      "field": "featured_image",
      "type": "uuid",
      "meta": { "interface": "file-image" }
    },
    {
      "collection": "tour_packages",
      "field": "inclusions",
      "type": "json",
      "meta": { "interface": "tags" }
    },
    {
      "collection": "tour_packages",
      "field": "itinerary",
      "type": "json",
      "meta": { "interface": "list", "note": "Day-by-day itinerary objects with title, description, stay, and meals" }
    },
    {
      "collection": "blogs",
      "field": "id",
      "type": "string",
      "meta": { "interface": "input", "hidden": true },
      "schema": { "is_primary_key": true }
    },
    {
      "collection": "blogs",
      "field": "status",
      "type": "string",
      "meta": { "interface": "select-dropdown" }
    },
    {
      "collection": "blogs",
      "field": "title",
      "type": "string",
      "meta": { "interface": "input", "required": true }
    },
    {
      "collection": "blogs",
      "field": "slug",
      "type": "string",
      "meta": { 
        "interface": "slug", 
        "required": true, 
        "options": { "field": "title", "slugify": true, "allowManual": true },
        "note": "Auto-generates as user types the Title with full manual override" 
      }
    },
    {
      "collection": "blogs",
      "field": "excerpt",
      "type": "text",
      "meta": { "interface": "textarea" }
    },
    {
      "collection": "blogs",
      "field": "content",
      "type": "text",
      "meta": { "interface": "input-rich-text-html" }
    },
    {
      "collection": "blogs",
      "field": "cover_image",
      "type": "uuid",
      "meta": { "interface": "file-image" }
    },
    {
      "collection": "blogs",
      "field": "category",
      "type": "string",
      "meta": { "interface": "select-dropdown" }
    },
    {
      "collection": "blogs",
      "field": "author_name",
      "type": "string",
      "meta": { "interface": "input" }
    },
    {
      "collection": "blogs",
      "field": "published_date",
      "type": "date",
      "meta": { "interface": "datetime" }
    },
    {
      "collection": "blogs",
      "field": "read_time",
      "type": "string",
      "meta": { "interface": "input", "placeholder": "6 min read" }
    },
    {
      "collection": "blogs",
      "field": "tags",
      "type": "json",
      "meta": { "interface": "tags" }
    },
    {
      "collection": "blogs",
      "field": "suggested_packages",
      "type": "alias",
      "meta": {
        "interface": "list-m2m",
        "special": ["m2m"],
        "note": "Manual selection of specific Tour Packages to display at bottom of blog. If left empty, automated tag matching will be used."
      }
    },
    {
      "collection": "blogs",
      "field": "seo_meta_title",
      "type": "string",
      "meta": { "interface": "input" }
    },
    {
      "collection": "blogs",
      "field": "seo_meta_description",
      "type": "text",
      "meta": { "interface": "textarea" }
    },
    {
      "collection": "blogs",
      "field": "focus_keywords",
      "type": "string",
      "meta": { "interface": "input" }
    }
  ]
}
