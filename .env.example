# Comfort Journey Environment Variables Example
# Copy this file to .env.local and add your private keys.
# .env.local is automatically ignored by Git and will NEVER be leaked or published.

# Optional: Google Gemini Free API Key from Google AI Studio (https://aistudio.google.com/)
# If provided, the AI Concierge uses live Gemini 1.5 / 2.0 Flash intelligence.
# If omitted, the website automatically falls back to its built-in Comfort Journey semantic knowledge engine.
GEMINI_API_KEY=

# Optional: Google OAuth 2.0 Client ID for 1-Click "Continue with Google"
# Obtain free from Google Cloud Console (APIs & Services > Credentials > OAuth client ID)
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Optional: Microsoft Entra ID / Microsoft Account OAuth 2.0 Client ID for 1-Click "Continue with Microsoft"
# Obtain free from Azure Portal (portal.azure.com > Microsoft Entra ID > App registrations)
# Supports personal (@outlook.com, @hotmail.com) and work/school Microsoft accounts (100% Free Forever)
VITE_MICROSOFT_CLIENT_ID=
