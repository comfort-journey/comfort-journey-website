import wixData from 'wix-data';

/**
 * Comfort Journey - Velo Backend Web Module
 * Server-side fetching & lead submission
 */

export async function fetchTours(query = '', category = 'All') {
    try {
        let tourQuery = wixData.query("TourPackages");

        const cleanQuery = query ? query.trim() : '';
        if (cleanQuery.length > 0) {
            tourQuery = tourQuery.contains("title", cleanQuery)
                .or(wixData.query("TourPackages").contains("location", cleanQuery));
        }

        if (category && category !== 'All') {
            tourQuery = tourQuery.eq("category", category);
        }

        const results = await tourQuery.ascending("price").limit(24).find();
        return results.items;
    } catch (error) {
        console.error("Backend fetchTours error:", error);
        return [];
    }
}

export async function submitEnquiry(leadData) {
    try {
        if (!leadData || !leadData.name || !leadData.phone) {
            return false;
        }

        const toInsert = {
            name: leadData.name.trim(),
            phone: leadData.phone.trim(),
            destination: leadData.destination ? leadData.destination.trim() : 'General Enquiry',
            createdDate: new Date(),
            source: 'Wix Floating Dock / Custom Form',
            status: 'New'
        };

        await wixData.insert("Enquiries", toInsert);
        return true;
    } catch (error) {
        console.error("Backend submitEnquiry error:", error);
        return false;
    }
}

