# ==============================================================================
# Comfort Journey - Production Docker Environment Variables
# Copy this file to .env before starting Docker services:
#   cp .env.docker.example .env
# ==============================================================================

# ----------------- 1. AWS RDS PostgreSQL 16 -----------------
# Replace with your AWS RDS Endpoint (e.g. comfort-journey-db.cxxxx.ap-south-1.rds.amazonaws.com)
RDS_HOST=comfort-journey-db.cxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=comfortjourney
RDS_USER=postgres
RDS_PASSWORD=YourStrongRdsPassword1992!
RDS_SSL=true

# ----------------- 2. Directus CMS Security & Credentials -----------------
# Generate unique secure strings for production
DIRECTUS_KEY=cj-prod-sec-key-77291048-travel-luxury
DIRECTUS_SECRET=cj-prod-sec-token-99382012-bhopal-vip
ADMIN_EMAIL=admin@comfortjourney.com
ADMIN_PASSWORD=ComfortAdminPass2026!

# ----------------- 3. Domain & Routing (/cms Endpoint) -----------------
# Directus is accessed via comfortjourneyy.com/cms or comfortjourney.in/cms
PUBLIC_URL=https://comfortjourneyy.com/cms
CORS_ORIGINS=https://comfortjourneyy.com,https://www.comfortjourneyy.com,https://comfortjourney.in,https://www.comfortjourney.in

# ----------------- 4. AWS S3 Media Storage (ap-south-1 Mumbai) -----------------
# Set STORAGE_LOCATIONS to 's3' in production to store tour photos/brochures on S3
STORAGE_LOCATIONS=s3
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
AWS_S3_BUCKET=comfort-journey-media-storage
AWS_REGION=ap-south-1

# ----------------- 5. AI Travel Concierge (Gemini 1.5 Flash) -----------------
GEMINI_API_KEY=AIzaSyYourSecretGeminiKeyHere
